services:
  mssql:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: list-mssql
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: "StrongP@ssw0rd!"
      MSSQL_PID: "Developer"
    ports:
      - "1433:1433"
    volumes:
      - ./mssql_data:/var/opt/mssql
    healthcheck:
      test: /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "StrongP@ssw0rd!" -C -Q "SELECT 1" || /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P "StrongP@ssw0rd!" -Q "SELECT 1" || exit 1
      interval: 10s
      timeout: 3s
      retries: 10

  mssql-init:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: mssql-init
    depends_on:
      mssql:
        condition: service_healthy
    volumes:
      - ./sql/init.sql:/init.sql
      - ./sql/seed.sql:/seed.sql
    command: >
      bash -c '
        set -e
        echo "Running init.sql..."
        /opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P "StrongP@ssw0rd!" -C -i /init.sql || /opt/mssql-tools/bin/sqlcmd -S mssql -U sa -P "StrongP@ssw0rd!" -i /init.sql
        echo "Running seed.sql..."
        /opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P "StrongP@ssw0rd!" -C -i /seed.sql || /opt/mssql-tools/bin/sqlcmd -S mssql -U sa -P "StrongP@ssw0rd!" -i /seed.sql
        echo "Database initialized."
      '
